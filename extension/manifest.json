{
  "manifest_version": 3,
  "name": "Browser Lock",
  "version": "2.0.0",
  "description": "Locks the browser until you sign in with a one-time code sent to your email. Works in Chrome and Edge.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://browser-lock.YOUR-SUBDOMAIN.workers.dev/*"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Lock",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}